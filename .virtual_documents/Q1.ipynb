import pandas as pd; import warnings; warnings.filterwarnings('ignore')

sales = pd.read_csv('sales_transactions.csv')
customers = pd.read_csv('customers.csv')
products = pd.read_csv('products.csv')

for name,df in [('Sales',sales),('Customers',customers),('Products',products)]:
    print(f'\n----- {name} -----'); display(df.head())

def Indates(df, cols):
    return sum(int((pd.to_datetime(df[c],errors='coerce').pipe(lambda s: s.isna()|~s.dt.year.between(2010,2025))).sum()) for c in cols)

def negavalues(df, cols):
    return sum(int((pd.to_numeric(df[c].astype(str).str.replace('$','',regex=False),errors='coerce')<0).sum()) for c in cols if c in df.columns)

checks = {
    'sales_transactions.csv': [Indates(sales,['date']), negavalues(sales,['quantity','price','discount_amount']),
        int((~sales.customer_id.isin(customers.customer_id)|~sales.product_id.isin(products.product_id)).sum()),0,0],
    'customers.csv': [Indates(customers,['join_date','last_purchase_date']), negavalues(customers,['total_spending','average_order_value','frequency']),
        0, int((customers.gender.notna()&~customers.gender.isin(['M','F'])).sum()),
        int(customers.email.str.contains('A-Z',na=False).sum()),
        int(customers.age.isna().sum()),
        int((~customers.membership_status.isin(['Basic','Silver','Gold'])).sum()),
        int((customers.preferred_category.notna()&~customers.preferred_category.isin(['Macaron','Bread','Pastries','Tarte'])).sum()),
        int((~customers.churned.isin(['False','True'])).sum())],
    'products.csv': [Indates(products,['introduced_date']), negavalues(products,['price','cost']),
        0, int((products.category.isin(['Tarte','Bread','Pastry','Viennoiserie'])).sum()),
        int(products[['price','cost']].apply(lambda c: c.astype(str).str.contains(r'\$',na=False)).sum().sum()),
        int((~products.seasonal.isin(['False','True'])).sum()),
        int((~products.active.isin(['False','True'])).sum())]
}

title = ['Invalid Dates','Negative Values','Invalid IDs','Unexpected Values','Formatting Issues']
report = ''

for name, df in [('sales_transactions.csv',sales),('customers.csv',customers),('products.csv',products)]:
    block = f'##### File: {name} \n Data Types: \n'
    block += '\n'.join(f'  - {c}: {t}' for c,t in df.dtypes.items())
    block += '\n\nInconsistencies:\n'
    block += '\n'.join(f'  - {k}: {y}' for k,y in zip(title, checks[name]))
    block += '\n' + '#'*50 + '\n'
    report += block

open('Session1_DataExploration.txt','w',encoding='utf-8').write(report.strip())
print('Success')






