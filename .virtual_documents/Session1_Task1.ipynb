


import pandas as pd
import warnings; warnings.filterwarnings('ignore')

# pd.read_csv() → โหลดไฟล์ CSV เข้ามาเป็น DataFrame
sales     = pd.read_csv('sales_transactions.csv')
customers = pd.read_csv('customers.csv')
products  = pd.read_csv('products.csv')

# แสดง 5 แถวแรกของทุกไฟล์
for name, df in [('sales', sales), ('customers', customers), ('products', products)]:
    print(f'\n=== {name} ===')
    display(df.head())


# ดู data types และ missing values
# .dtypes    → ชนิดข้อมูลของแต่ละคอลัมน์
# .isnull()  → ตรวจว่าแต่ละค่าเป็นค่าว่างไหม (True/False)
# .sum()     → นับจำนวน True ทั้งหมด = จำนวนค่าว่าง
for name, df in [('sales', sales), ('customers', customers), ('products', products)]:
    print(f'\n--- {name} dtypes ---')
    print(df.dtypes)
    print(f'\n--- {name} missing ---')
    print(df.isnull().sum())


# ฟังก์ชันตรวจวันที่ผิดปกติ (อ่านไม่ออก หรือปีไม่อยู่ในช่วง 2010-2025)
def count_invalid_dates(df, cols):
    total = 0
    for col in cols:
        parsed = pd.to_datetime(df[col], errors='coerce')          # แปลงเป็น datetime ถ้าไม่ได้ → NaT
        bad = parsed.isna() | ~parsed.dt.year.between(2010, 2025)  # เช็ค 2 เงื่อนไข
        total += bad.sum()
    return int(total)

# ฟังก์ชันตรวจค่าติดลบ (รองรับกรณีมีเครื่องหมาย $ ติดมา)
def count_negative(df, cols):
    total = 0
    for col in cols:
        if col in df.columns:
            nums = pd.to_numeric(df[col].astype(str).str.replace('$','',regex=False), errors='coerce')
            total += (nums < 0).sum()
    return int(total)


# ตรวจสอบคุณภาพข้อมูลแต่ละไฟล์
checks = {
    'sales_transactions.csv': {
        'Invalid Dates'    : count_invalid_dates(sales, ['date']),
        'Negative Values'  : count_negative(sales, ['quantity','price','discount_amount']),
        'Invalid IDs'      : int((~sales.customer_id.isin(customers.customer_id) | ~sales.product_id.isin(products.product_id)).sum()),
        'Unexpected Values': 0,
        'Formatting Issues': 0,
    },
    'customers.csv': {
        'Invalid Dates'    : count_invalid_dates(customers, ['join_date','last_purchase_date']),
        'Negative Values'  : count_negative(customers, ['total_spending','average_order_value']),
        'Invalid IDs'      : 0,
        'Unexpected Values': int((customers.gender.notna() & ~customers.gender.isin(['M','F'])).sum()),
        'Formatting Issues': int(customers.email.str.contains('[A-Z]', na=False).sum()),
    },
    'products.csv': {
        'Invalid Dates'    : count_invalid_dates(products, ['introduced_date']),
        'Negative Values'  : count_negative(products, ['price','cost']),
        'Invalid IDs'      : 0,
        'Unexpected Values': int((products.category.notna() & ~products.category.isin(['Pastries','Bread','Tarte'])).sum()),
        'Formatting Issues': int(products[['price','cost']].apply(lambda c: c.astype(str).str.contains(r'\$', na=False)).sum().sum()),
    },
}

# สร้าง report และ export
report = ''
for name, df in [('sales_transactions.csv', sales), ('customers.csv', customers), ('products.csv', products)]:
    block  = f'### File: {name}\nData Types:\n'
    block += '\n'.join(f'  - {c}: {t}' for c, t in df.dtypes.items())
    block += '\n\nInconsistencies:\n'
    block += '\n'.join(f'  - {k}: {v}' for k, v in checks[name].items())
    block += '\n' + '-'*40 + '\n'
    print(block)
    report += block

# open().write() → บันทึกข้อความลงไฟล์
open('Session1_DataExploration.txt', 'w', encoding='utf-8').write(report.strip())
print('✅ Saved Session1_DataExploration.txt')

# === จุดสังเกต ===
# ✔ ไฟล์ Session1_DataExploration.txt ถูกสร้างขึ้นในโฟลเดอร์
# ✔ customers Invalid Dates ควรมีค่าสูง (join_date + last_purchase_date มีปีเพี้ยน)
# ✔ products Formatting Issues ควรเป็น 45 (price + cost มี $ ติดมา)
